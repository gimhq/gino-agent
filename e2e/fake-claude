#!/usr/bin/env bash
# Fake "claude" engine for the gino docker e2e.
#
# The gino-agent's only engine spawns a `claude` binary from PATH and drives it
# over the bkd stream-json control protocol (see gino-agent/src/engine/claude).
# This script is a deterministic, network-free stand-in that speaks exactly the
# lines `events::map_line` parses — modelled on the test harness fake at
# gino-agent/tests/support/fake_claude.rs:
#
#   1. a `system/init`  line               → runner SessionStarted
#   2. one `assistant` text block          → runner Output → host thread_message
#   3. a sub-agent sequence, so the e2e can assert `tool_use_id` /
#      `parent_tool_use_id` attribution end to end (protocol §5):
#        3a. an `assistant` `tool_use` block spawning the `Task` sub-agent, with
#            NO top-level `parent_tool_use_id` (the MAIN agent spawns it)
#        3b. an `assistant` text block carrying `parent_tool_use_id` = that
#            tool-use id (the SUB-AGENT talking)
#        3c. a `user` `tool_result` block closing the same tool-use id, back on
#            the main agent (top-level `parent_tool_use_id` null)
#   4. a terminal `result`/success line with `usage` → runner Result → host
#      thread_result(succeeded) carrying the usage
#
# It additionally drains stdin to recover the user prompt the runner streams in
# (control_request `initialize`, `set_permission_mode`, then a `user` turn) and
# echoes it back, so the e2e can assert a full host→ws→runner→engine→ws→host
# content round-trip. The reply ends with a marker reporting whether the runner
# exported the task/agent memory directories (`memory-env task=set|unset
# agent=set|unset`) and the claude auto memory state it was launched with
# (`automem=dir|off|unset`: an `autoMemoryDirectory` ending in `/claude` in
# `--settings`, or `autoMemoryEnabled:false` plus
# `CLAUDE_CODE_DISABLE_AUTO_MEMORY=1`), so the e2e can assert the effective
# memory settings.
#
# It answers the agent's engine probe without counting it as a run: `--version`,
# `auth status --json` (signed in when ANTHROPIC_API_KEY or CLAUDE_CODE_OAUTH_TOKEN
# is set) and, for an invocation without `--session-id` / `--resume`, the
# stream-json `initialize` control request with a fixed model list whose default
# is `fake-e2e`.
#
# For host joint runs it also:
#   - appends `{"engine":"claude","argv":[...],"probe":"$JOINT_PROBE"}` to
#     `$FAKE_ENGINE_LOG` when that variable is set (a host can set both through
#     `config.engine.env`, proving flags and env reach the engine);
#   - copies each file of `../inputs/` (the work dir's inbound attachments) to
#     `../output/<name>.out` prefixed with `processed:`, so result attachments
#     come back;
#   - waits N seconds after its first event when the prompt holds `sleep:N`, so
#     an interrupt can land mid-turn.
set -u

[ "${1:-}" = --version ] && { echo "2.0.0 (fake)"; exit 0; }
if [ "${1:-}" = auth ]; then
  logged_in=false
  [ -n "${ANTHROPIC_API_KEY:-}${CLAUDE_CODE_OAUTH_TOKEN:-}" ] && logged_in=true
  printf '{"loggedIn":%s,"authMethod":"fake"}\n' "$logged_in"
  exit 0
fi
case " $* " in
  *' --session-id '*|*' --resume '*) ;;
  *)
    IFS= read -r line || exit 0
    jq -cn --arg id "$(printf '%s' "$line" | jq -r '.request_id // empty')" '
      {type:"control_response",response:{subtype:"success",request_id:$id,response:{models:[
        {value:"default",resolvedModel:"fake-e2e",displayName:"Default (recommended)"},
        {value:"fake-e2e",displayName:"Fake E2E"},
        {value:"m-task",displayName:"Task model",description:"for task-level overrides"}]}}}'
    exit 0
    ;;
esac

if [ -n "${FAKE_ENGINE_LOG:-}" ]; then
  jq -cn --arg probe "${JOINT_PROBE:-}" '{engine:"claude",argv:$ARGS.positional,probe:$probe}' \
    --args -- "$@" >> "$FAKE_ENGINE_LOG"
fi

settings="{}"
prev=""
for arg in "$@"; do
  case "$prev" in
    --settings) settings="$arg" ;;
    --fallback-model) [ -n "$arg" ] || { echo "error: --fallback-model needs a model" >&2; exit 2; } ;;
    --max-turns)
      case "$arg" in ''|*[!0-9]*) echo "error: --max-turns needs a number" >&2; exit 2 ;; esac
      ;;
    --mcp-config)
      printf '%s' "$arg" | jq -e '.mcpServers | type == "object"' >/dev/null 2>&1 \
        || { echo "error: --mcp-config is not an MCP config" >&2; exit 2; }
      ;;
  esac
  prev="$arg"
done
case "$prev" in
  --fallback-model|--max-turns|--mcp-config) echo "error: $prev needs a value" >&2; exit 2 ;;
esac
automem="$(printf '%s' "$settings" | jq -r --arg off "${CLAUDE_CODE_DISABLE_AUTO_MEMORY:-}" '
  if (.autoMemoryDirectory // "" | endswith("/claude")) then "dir"
  elif .autoMemoryEnabled == false and $off == "1" then "off"
  else "unset" end' 2>/dev/null || echo unset)"

SID="sess-e2e-$$"

emit() { printf '%s\n' "$1"; }

# 1) Announce the session immediately (before reading stdin) so the runner's
#    reader sees SessionStarted and proceeds to stream the user turn in.
emit "{\"type\":\"system\",\"subtype\":\"init\",\"session_id\":\"${SID}\",\"model\":\"fake-e2e\",\"tools\":[]}"

# 2) Drain stdin briefly to capture the user prompt. `read -t 1` returns non-zero
#    on both timeout and EOF; bound the whole wait to ~5s so a run can never hang.
prompt=""
deadline=$(( $(date +%s) + 5 ))
while [ "$(date +%s)" -lt "$deadline" ]; do
  if IFS= read -r -t 1 line; then
    case "$line" in
      *'"type":"user"'*)
        prompt="$(printf '%s' "$line" | jq -r '
          .message.content
          | if type=="string" then .
            elif type=="array" then (map(select(.type=="text").text) | join(" "))
            else tostring end' 2>/dev/null || true)"
        break
        ;;
    esac
  fi
done

if [ -d ../inputs ]; then
  mkdir -p ../output
  for f in ../inputs/*; do
    [ -f "$f" ] && { printf 'processed:'; cat "$f"; } > "../output/$(basename "$f").out"
  done
fi

reply="gino-e2e ok"
[ -n "$prompt" ] && reply="gino-e2e ok: ${prompt}"
reply="${reply} memory-env task=$([ -n "${GINO_MEMORY_DIR:-}" ] && echo set || echo unset) agent=$([ -n "${GINO_AGENT_MEMORY_DIR:-}" ] && echo set || echo unset) automem=${automem}"

# 3) Assistant text block — jq builds valid JSON regardless of prompt contents.
emit "$(jq -cn --arg t "$reply" \
  '{type:"assistant",message:{role:"assistant",content:[{type:"text",text:$t}]}}')"
# A `sleep:N` prompt holds the turn open after its first event.
case "$prompt" in
  *sleep:[0-9]*) sleep "$(printf '%s' "$prompt" | sed -n 's/.*sleep:\([0-9]*\).*/\1/p')" ;;
esac

# 4) Sub-agent sequence — a `Task` tool_use spawned by the main agent, the
#    sub-agent's own text (attributed by parent_tool_use_id) and the tool_result
#    that returns to the main agent. The tool-use id is fixed so the e2e can pin it.
TASK_ID="toolu_e2e_task_1"

emit "$(jq -cn --arg id "$TASK_ID" \
  '{type:"assistant",message:{role:"assistant",content:[
      {type:"tool_use",id:$id,name:"Task",
       input:{description:"e2e sub-agent probe",prompt:"say hello"}}]}}')"

emit "$(jq -cn --arg id "$TASK_ID" \
  '{type:"assistant",parent_tool_use_id:$id,message:{role:"assistant",content:[
      {type:"text",text:"gino-e2e subagent ok"}]}}')"

emit "$(jq -cn --arg id "$TASK_ID" \
  '{type:"user",parent_tool_use_id:null,message:{role:"user",content:[
      {type:"tool_result",tool_use_id:$id,content:"gino-e2e subagent result",is_error:false}]}}')"

# 5) Terminal success result — carries the session id (the resume handle).
emit "$(jq -cn --arg s "$SID" --arg r "$reply" \
  '{type:"result",subtype:"success",is_error:false,result:$r,session_id:$s,
    usage:{input_tokens:12,output_tokens:5,cache_read_input_tokens:3},total_cost_usd:0.001}')"
